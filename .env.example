# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#
# .env добавлен в .gitignore и в репозиторий не попадает.
# Рабочие токены, пароли и ключи в репозитории запрещены правилами кейса -
# они передаются только на служебном первом слайде презентации.
# Реальных значений в этом файле нет и быть не должно.

# ---------- База данных ----------
DB_NAME=approval
DB_USER=approval
# Любая строка для локального запуска. Задать обязательно - compose не стартует без неё.
DB_PASSWORD=

# ---------- Хранилище файлов (MinIO) ----------
# Минимум 3 символа / 8 символов соответственно - требование MinIO.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents

# ---------- ИИ ----------
# Провайдер модели. Код зависит от порта, а не от конкретного провайдера.
# gigachat | openai-compatible | ollama | none
AI_PROVIDER=gigachat
# false полностью отключает обращения к LLM - остаются проверки по правилам.
AI_ENABLED=true

# Authorization key из личного кабинета GigaChat (Base64 client_id:client_secret).
# Единственный внешний сервис, невоспроизводимый внутри Docker.
# Если пусто - бэкенд стартует, сценарий проходится, ИИ-сверка деградирует
# до детерминированных проверок правил (см. README, "Поведение без модели").
GIGACHAT_CREDENTIALS=
# Идентификатор проекта. Секрет отдельно не нужен: он уже входит в Authorization key.
GIGACHAT_CLIENT_ID=
# GIGACHAT_API_PERS - физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP - юрлица.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
AI_TIMEOUT_SECONDS=30

# ---------- MAX ----------
# Токен чат-бота выдаётся организаторами хакатона. Наш бот: @t354_hakaton_max_bot.
MAX_BOT_TOKEN=
# Официальный адрес с 19.07.2026. Токен передаётся только заголовком Authorization.
MAX_BOT_API_URL=https://platform-api2.max.ru
# Публичный HTTPS-адрес мини-приложения. Регистрируют организаторы по нашей форме,
# поэтому адрес постоянный: свой домен стенда, а не случайный адрес туннеля.
MAX_MINI_APP_URL=
# Ключ подписи ссылок скачивания. Можно не задавать: тогда случайный при каждом запуске.
DOWNLOAD_LINK_SECRET=

# ---------- Режимы ----------
# true - включает переключатель участника, чтобы один проверяющий мог пройти
# всю цепочку согласования самостоятельно. В проде false.
DEMO_MODE=false

# ---------- Порты на хосте ----------
BACKEND_PORT=8080
FRONTEND_PORT=8081
